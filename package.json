{
  "name": "millpond",
  "version": "0.0.0",
  "description": "An in-memory reactive database for TypeScript — schema'd tables, ops-only writes, incremental aggregates, effects, and subscribable queries.",
  "type": "module",
  "license": "MIT",
  "author": "Jani Mustonen <me@seequ.dev>",
  "keywords": [
    "database",
    "reactive",
    "in-memory",
    "typescript",
    "standard-schema",
    "state-management",
    "react"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.2",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "demo": "vite demo",
    "typecheck": "tsc --noEmit",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:spec": "vitest run test/spec",
    "test:spec:watch": "vitest test/spec",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "verify:package": "publint && attw --pack",
    "verify": "biome ci . && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}
